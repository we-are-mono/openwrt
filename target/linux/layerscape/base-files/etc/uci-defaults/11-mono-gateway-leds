#!/bin/sh
# Mono Gateway status LED policy (LP5812 I2C controller).
#
# Done in userspace, not the DTS: the lp5812 driver does not parse
# `default-state` (it reads only reg/color/label/led-max-microamp and registers
# with the non-_ext classdev call), and its probe never resets the chip - so it
# leaves whatever U-Boot set. U-Boot lights green led during boot; set the
# steady state here instead. Runs once (uci-defaults self-deletes); the `led`
# service then re-applies /etc/config/system on every boot.
#
# Scheme: all off, white on - dim static "ready" light.
. /lib/functions.sh

case "$(board_name)" in
mono,gateway-dk) ;;
*) exit 0 ;;
esac

uci -q batch <<'EOF'
delete system.led_status_red
delete system.led_status_green
delete system.led_status_blue
delete system.led_status_white
delete system.led_status

set system.led_status=led
set system.led_status.name='Status RGBW'
set system.led_status.sysfs='status:rgbw'
set system.led_status.trigger='none'
set system.led_status.default='1'
set system.led_status.color_red='0'
set system.led_status.color_green='0'
set system.led_status.color_blue='0'
set system.led_status.color_white='16'
EOF
uci commit system

exit 0
