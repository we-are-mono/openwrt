From: Tomaz Zaman <tomaz@mono.si>
Date: Thu, 21 Aug 2025 12:00:00 +0000
Subject: [PATCH] layerscape: SDK build compat against mainline 6.12 kernel

The vendored NXP DPAA SDK drivers target the NXP LSDK kernel, which carries
APIs mainline lacks. Provide them so the SDK builds on OpenWrt's kernel:
 - ioremap_cache_ns() / pgprot_cached_ns(): bman/qman/usdpaa cacheable portal
   and buffer mappings. mainline has no *_ns (PROT_NORMAL_NS) variants; the NS
   attribute is irrelevant on the non-secure LS1046, so provide them in terms
   of the plain cacheable Normal-memory forms.
 - phylink_interface_max_speed(): exported by the NXP kernel, static in
   mainline. The sdk_dpaa MAC driver calls it -- un-static + export.
 - skb_recycle(): removed from mainline long ago but kept by the NXP kernel and
   used by sdk_dpaa's Tx recycle path. Restore it (verbatim from the NXP tree).

Signed-off-by: Tomaz Zaman <tomaz@mono.si>
---
--- a/arch/arm64/include/asm/io.h
+++ b/arch/arm64/include/asm/io.h
@@ -312,6 +312,10 @@
 #include <asm-generic/io.h>
 
 #define ioremap_cache ioremap_cache
+/* NXP DPAA SDK (bman/qman portal CE) maps cacheable memory via ioremap_cache_ns.
+ * mainline lacks it; the NS attribute is irrelevant on the non-secure LS1046, so
+ * map it onto ioremap_cache (cacheable Normal memory). */
+#define ioremap_cache_ns(addr, size)	ioremap_cache((addr), (size))
 static inline void __iomem *ioremap_cache(phys_addr_t addr, size_t size)
 {
 	if (pfn_is_map_memory(__phys_to_pfn(addr)))
--- a/arch/arm64/include/asm/pgtable.h
+++ b/arch/arm64/include/asm/pgtable.h
@@ -678,6 +678,13 @@
 	__pgprot_modify(prot, PTE_ATTRINDX_MASK, PTE_ATTRINDX(MT_DEVICE_nGnRnE) | PTE_PXN | PTE_UXN)
 #define pgprot_writecombine(prot) \
 	__pgprot_modify(prot, PTE_ATTRINDX_MASK, PTE_ATTRINDX(MT_NORMAL_NC) | PTE_PXN | PTE_UXN)
+/* NXP DPAA SDK (usdpaa mmap) uses pgprot_cached_ns for cacheable, non-shareable
+ * userspace mappings of portal/buffer memory. mainline arm64 has neither macro. */
+#define pgprot_cached(prot) \
+	__pgprot_modify(prot, PTE_ATTRINDX_MASK, PTE_ATTRINDX(MT_NORMAL) | \
+			PTE_PXN | PTE_UXN)
+#define pgprot_cached_ns(prot) \
+	__pgprot(pgprot_val(pgprot_cached(prot)) ^ PTE_SHARED)
 #define pgprot_device(prot) \
 	__pgprot_modify(prot, PTE_ATTRINDX_MASK, PTE_ATTRINDX(MT_DEVICE_nGnRE) | PTE_PXN | PTE_UXN)
 #define pgprot_tagged(prot) \
--- a/drivers/net/phy/phylink.c
+++ b/drivers/net/phy/phylink.c
@@ -222,7 +222,7 @@
  *
  * Return: The maximum speed of @interface
  */
-static int phylink_interface_max_speed(phy_interface_t interface)
+int phylink_interface_max_speed(phy_interface_t interface)
 {
 	switch (interface) {
 	case PHY_INTERFACE_MODE_100BASEX:
@@ -283,6 +283,7 @@
 	WARN_ON_ONCE(1);
 	return SPEED_UNKNOWN;
 }
+EXPORT_SYMBOL_GPL(phylink_interface_max_speed);
 
 /**
  * phylink_caps_to_linkmodes() - Convert capabilities to ethtool link modes
--- a/include/linux/phylink.h
+++ b/include/linux/phylink.h
@@ -163,6 +163,7 @@
 };
 
 void phylink_limit_mac_speed(struct phylink_config *config, u32 max_speed);
+int phylink_interface_max_speed(phy_interface_t interface);
 
 /**
  * struct phylink_mac_ops - MAC operations structure.
--- a/net/core/skbuff.c
+++ b/net/core/skbuff.c
@@ -1532,6 +1532,32 @@
 }
 EXPORT_SYMBOL(napi_consume_skb);
 
+/**
+ * 	skb_recycle - clean up an skb for reuse
+ * 	@skb: buffer
+ *
+ * 	Recycles the skb to be reused as a receive buffer. This
+ * 	function does any necessary reference count dropping, and
+ * 	cleans up the skbuff as if it just came from __alloc_skb().
+ */
+void skb_recycle(struct sk_buff *skb)
+{
+	struct skb_shared_info *shinfo;
+	u8 head_frag = skb->head_frag;
+
+	skb_release_head_state(skb);
+
+	shinfo = skb_shinfo(skb);
+	memset(shinfo, 0, offsetof(struct skb_shared_info, dataref));
+	atomic_set(&shinfo->dataref, 1);
+
+	memset(skb, 0, offsetof(struct sk_buff, tail));
+	skb->data = skb->head + NET_SKB_PAD;
+	skb->head_frag = head_frag;
+	skb_reset_tail_pointer(skb);
+}
+EXPORT_SYMBOL(skb_recycle);
+
 /* Make sure a field is contained by headers group */
 #define CHECK_SKB_FIELD(field) \
 	BUILD_BUG_ON(offsetof(struct sk_buff, field) !=		\
--- a/include/linux/skbuff.h
+++ b/include/linux/skbuff.h
@@ -1341,6 +1341,7 @@
 #endif
 
 void __consume_stateless_skb(struct sk_buff *skb);
+void skb_recycle(struct sk_buff *skb);
 void  __kfree_skb(struct sk_buff *skb);
 
 void kfree_skb_partial(struct sk_buff *skb, bool head_stolen);
