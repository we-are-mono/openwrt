;; cdxctrlnodedev.cil — private label for /dev/cdx_ctrl
;; char dev created by cdx.ko; devtmpfs auto-creates the node. No domain is granted it: its only
;; userspace clients (cmm, dpa_app) retired with ASK's move to flowtable offload. The private
;; label keeps the node out of tmp.fs.
;; Mirrors dev/nodedev/pppnodedev.cil verbatim.
(block cdxctrl

  (filecon "/dev/cdx_ctrl" char nodedev_context)

  (macro tmp_fs_type_transition_nodedev ((type ARG1))
    (call .tmp.fs_type_transition
      (ARG1 nodedev chr_file "cdx_ctrl")))

  (blockinherit .nodedev.template))

(in nodedev.unconfined

  (call .cdxctrl.tmp_fs_type_transition_nodedev (typeattr)))
