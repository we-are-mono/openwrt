#!/bin/sh /etc/rc.common
# hwmon indices depend on driver probe order, so /etc/fancontrol.in is a
# template: resolve the fan controller and temperature source by name at
# every start and generate the real config. Ported from the meta-mono
# S99fancontrol; fancontrol runs in the foreground under procd.

START=95
USE_PROCD=1

TEMPLATE=/etc/fancontrol.in
CONF=/var/run/fancontrol

find_hwmon() {
	for h in /sys/class/hwmon/hwmon*; do
		[ "$(cat "$h/name" 2>/dev/null)" = "$1" ] && {
			basename "$h"
			return 0
		}
	done
	return 1
}

generate_conf() {
	local fan temp fan_path temp_path
	fan=$(find_hwmon emc2305) || {
		echo "fancontrol: no emc2305 hwmon device, not starting" >&2
		return 1
	}
	temp=$(find_hwmon cluster_thermal) || {
		echo "fancontrol: no cluster_thermal hwmon device, not starting" >&2
		return 1
	}
	fan_path=$(readlink -f "/sys/class/hwmon/$fan/device" | sed 's|^/sys/||')
	temp_path=$(readlink -f "/sys/class/hwmon/$temp/device" | sed 's|^/sys/||')
	sed -e "s|@FAN@|$fan|g" \
		-e "s|@TEMP@|$temp|g" \
		-e "s|@FAN_PATH@|$fan_path|g" \
		-e "s|@TEMP_PATH@|$temp_path|g" \
		"$TEMPLATE" > "$CONF"
}

start_service() {
	generate_conf || return 1
	procd_open_instance
	procd_set_param command /usr/sbin/fancontrol "$CONF"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
