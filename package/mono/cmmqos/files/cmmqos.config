# Mono Gateway CEETM QoS — UCI front-end for cmm's queue manager.
# Rendered to 'set qm ...' directives (see cmm module_qm.c) and applied
# live via 'cmm -c qm-config' — no cmm restart. Rates are in Kbps.
# Off unless 'global' enabled = 1. Disabling + reloading flushes all QoS.

config cmmqos 'global'
	option enabled '0'

# --- Per-interface egress shaper ---------------------------------------
# set qm interface <name> qos {on|off}
# set qm interface <name> shaper [on|off] [rate <Kbps>] [bucketsize <b>]
#config interface
#	option name 'eth3'
#	option qos 'on'
#	option shaper 'on'
#	option rate '900000'
#	option bucketsize ''

# --- CEETM channel (1-8) -----------------------------------------------
# set qm channel <id> assign interface <name>
# set qm channel <id> shaper [on|off] [rate <Kbps>] [bucketsize]
# set qm channel <id> wbfq chshaper [on|off] [priority 0-6]
#config channel
#	option id '1'
#	option assign_interface 'eth3'
#	option shaper 'on'
#	option rate '900000'
#	option wbfq_chshaper 'on'
#	option wbfq_priority '3'

# --- Class queue on a channel (type pq | wbfq) -------------------------
# set qm channel <ch> classque <idx> [qdepth <d>] [priority ..]   (pq)
# set qm channel <ch> classque <idx> [qdepth <d>] [weight 1-255]  (wbfq)
# set qm channel <ch> classque <idx> cqshaper [on|off] [rate <Kbps>]
#config classque
#	option channel '1'
#	option index '0'
#	option type 'wbfq'
#	option qdepth ''
#	option weight '10'
#	option priority ''
#	option cqshaper 'on'
#	option cqrate '100000'

# --- DSCP -> channel/queue map -----------------------------------------
# set qm dscp-to-fqmap <iface> enable
# set qm dscp-to-fqmap <iface> dscp <0-63> channel-id <0-7> classqueue <0-15>
# each 'dscp' list entry = "<dscp> <channel-id> <classqueue>"
#config dscp_map
#	option interface 'eth3'
#	option enabled 'on'
#	list dscp '46 0 0'
#	list dscp '0  1 15'

# --- Ingress policing --------------------------------------------------
# set qm ingress queue <0-7|default> policer {on|off}
# set qm ingress queue <1-7|default> [cir <>] [pir <>]
#config ingress
#	option queue '1'
#	option policer 'on'
#	option cir '1000000'
#	option pir '1000000'

# --- SEC (IPsec) rate --------------------------------------------------
# set qm sec_rate [cir] [pir] [cbs] [pbs]
#config sec_rate
#	option cir ''
#	option pir ''
#	option cbs ''
#	option pbs ''

# --- Fast-forward / exception rate -------------------------------------
# set qm ff_rate <port> [cir <>] [pir <>]
# set qm expt_rate <eth> <val1> <val2>
#config rate
#	option type 'ff'
#	option port 'eth3'
#	option cir ''
#	option pir ''
#	option val1 ''
#	option val2 ''
