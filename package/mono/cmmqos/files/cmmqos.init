#!/bin/sh /etc/rc.common
# Mono Gateway CEETM QoS. Renders /etc/config/cmmqos into cmm 'set qm'
# directives and applies them live via 'cmm -c qm-config' (no cmm restart,
# which would drop the fast path). Disabling + reloading applies an empty
# config, which item 7's qm-config flushes-then-applies == QoS off.
#
# 'apply' is exposed as an action so the cmm-supervise wrapper can re-push
# QoS after cmm (re)starts. apply() takes an flock because that wrapper and
# the boot-time start_service can now run it concurrently.

USE_PROCD=1
START=55
STOP=09

EXTRA_COMMANDS="apply"
EXTRA_HELP="	apply	Render and push the QoS config into the running cmm"

CONF=/tmp/cmmqos.conf
LOCK=/tmp/cmmqos.lock
BOARD="mono,gateway-dk"

qm() { printf 'set qm %s\n' "$*" >> "$CONF"; }

render_interface() {
	local name qos shaper rate bucketsize
	config_get name "$1" name; [ -n "$name" ] || return 0
	config_get qos "$1" qos
	[ -n "$qos" ] && qm "interface $name qos $qos"
	config_get shaper "$1" shaper
	[ -n "$shaper" ] && {
		config_get rate "$1" rate; config_get bucketsize "$1" bucketsize
		qm "interface $name shaper $shaper${rate:+ rate $rate}${bucketsize:+ bucketsize $bucketsize}"
	}
}

render_channel() {
	local id assign_interface shaper rate bucketsize wbfq_chshaper wbfq_priority
	config_get id "$1" id; [ -n "$id" ] || return 0
	config_get assign_interface "$1" assign_interface
	[ -n "$assign_interface" ] && qm "channel $id assign interface $assign_interface"
	config_get shaper "$1" shaper
	[ -n "$shaper" ] && {
		config_get rate "$1" rate; config_get bucketsize "$1" bucketsize
		qm "channel $id shaper $shaper${rate:+ rate $rate}${bucketsize:+ bucketsize $bucketsize}"
	}
	config_get wbfq_chshaper "$1" wbfq_chshaper
	[ -n "$wbfq_chshaper" ] && {
		config_get wbfq_priority "$1" wbfq_priority
		qm "channel $id wbfq chshaper $wbfq_chshaper${wbfq_priority:+ priority $wbfq_priority}"
	}
}

render_classque() {
	local channel index type qdepth weight priority cqshaper cqrate
	config_get channel "$1" channel; config_get index "$1" index
	[ -n "$channel" ] && [ -n "$index" ] || return 0
	config_get type "$1" type
	config_get qdepth "$1" qdepth; config_get weight "$1" weight
	config_get priority "$1" priority
	case "$type" in
		wbfq) qm "channel $channel classque $index${qdepth:+ qdepth $qdepth}${weight:+ weight $weight}" ;;
		*)    qm "channel $channel classque $index${qdepth:+ qdepth $qdepth}${priority:+ priority $priority}" ;;
	esac
	config_get cqshaper "$1" cqshaper
	[ -n "$cqshaper" ] && {
		config_get cqrate "$1" cqrate
		qm "channel $channel classque $index cqshaper $cqshaper${cqrate:+ rate $cqrate}"
	}
}

render_dscp_map() {
	local interface enabled
	config_get interface "$1" interface; [ -n "$interface" ] || return 0
	config_get enabled "$1" enabled
	[ "$enabled" = "on" ] && qm "dscp-to-fqmap $interface enable"
	DSCP_IF="$interface"
	config_list_foreach "$1" dscp render_dscp_entry
}
render_dscp_entry() {
	set -- $1   # "<dscp> <channel-id> <classqueue>"
	[ -n "$3" ] && qm "dscp-to-fqmap $DSCP_IF dscp $1 channel-id $2 classqueue $3"
}

render_ingress() {
	local queue policer cir pir
	config_get queue "$1" queue; [ -n "$queue" ] || return 0
	config_get policer "$1" policer
	[ -n "$policer" ] && qm "ingress queue $queue policer $policer"
	config_get cir "$1" cir; config_get pir "$1" pir
	[ -n "$cir$pir" ] && qm "ingress queue $queue${cir:+ cir $cir}${pir:+ pir $pir}"
}

render_sec_rate() {
	local cir pir cbs pbs
	config_get cir "$1" cir; config_get pir "$1" pir
	config_get cbs "$1" cbs; config_get pbs "$1" pbs
	qm "sec_rate${cir:+ cir $cir}${pir:+ pir $pir}${cbs:+ cbs $cbs}${pbs:+ pbs $pbs}"
}

render_rate() {
	local type port cir pir val1 val2
	config_get type "$1" type; config_get port "$1" port
	case "$type" in
		ff)   config_get cir "$1" cir; config_get pir "$1" pir
		      qm "ff_rate $port${cir:+ cir $cir}${pir:+ pir $pir}" ;;
		expt) config_get val1 "$1" val1; config_get val2 "$1" val2
		      [ -n "$val2" ] && qm "expt_rate $port $val1 $val2" ;;
	esac
}

# Render the config and push it into the running cmm. Returns non-zero until
# cmm's CLI actually accepts the config, so cmm-supervise's retry loop keeps
# trying after a (re)start rather than giving up on the first not-ready reply.
_apply_locked() {
	[ "$(board_name)" = "$BOARD" ] || return 0

	config_load cmmqos
	local enabled; config_get_bool enabled global enabled 0

	: > "$CONF"
	if [ "$enabled" = "1" ]; then
		echo "# generated by cmmqos.init from /etc/config/cmmqos - do not edit" >> "$CONF"
		config_foreach render_interface interface
		config_foreach render_channel channel
		config_foreach render_classque classque
		config_foreach render_dscp_map dscp_map
		config_foreach render_ingress ingress
		config_foreach render_sec_rate sec_rate
		config_foreach render_rate rate
	fi
	# cmm's qm-config REFUSES a directive-less file — it will not wipe all QoS
	# that way (verified on hw: empty => "is empty"; comment-only => "has no
	# directives; refusing"). So "disabled" or "nothing rendered" means there is
	# nothing to push: succeed and leave cmm's live QoS untouched. (To actually
	# clear live QoS, restart cmm — the supervise wrapper re-applies on restart,
	# so a disabled config simply comes back up with no QoS programmed.)
	if ! grep -q '^set qm ' "$CONF"; then
		logger -t cmmqos "QoS off / no directives - nothing to apply"
		return 0
	fi

	# pidof, NOT 'pgrep -x cmm': busybox pgrep matches the full argv, so
	# 'pgrep -x cmm' never matches a cmm started with args (-f -n ...).
	pidof cmm >/dev/null 2>&1 || {
		logger -t cmmqos "cmm not running - QoS apply deferred"
		return 1
	}

	if cmm -c "qm-config $CONF" >/dev/null 2>&1; then
		logger -t cmmqos "applied $(grep -c '^set qm' "$CONF") QoS directives"
		return 0
	fi
	logger -t cmmqos "cmm not ready or rejected QoS config - will retry"
	return 1
}

apply() {
	# Cheap board gate before taking the lock; nothing to do off-target.
	[ "$(board_name)" = "$BOARD" ] || return 0
	(
		# busybox flock has no -w (timeout) — that is util-linux only. Block on
		# -x until acquired; holders are short (render a temp file + one
		# 'cmm -c'), so a plain blocking lock is safe and race-free here.
		flock -x 9 || { logger -t cmmqos "apply: could not lock $LOCK"; exit 1; }
		_apply_locked
	) 9>"$LOCK"
}

start_service()  { apply; }
reload_service() { apply; }
service_triggers() { procd_add_reload_trigger cmmqos; }
